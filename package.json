{
  "name": "level-up-society",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:ios": "npm --prefix apps/mobile run ios",
    "mobile:android": "npm --prefix apps/mobile run android",
    "telegram:db:create": "wrangler d1 create level-up-society-telegram --config cloudflare/telegram-gateway/wrangler.jsonc",
    "telegram:db:migrate": "wrangler d1 migrations apply level-up-society-telegram --remote --config cloudflare/telegram-gateway/wrangler.jsonc",
    "telegram:deploy": "wrangler deploy --config cloudflare/telegram-gateway/wrangler.jsonc"
  },
  "dependencies": {
    "@whop/sdk": "^2.6.0",
    "hls.js": "^1.7.3",
    "iron-session": "^9.0.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
