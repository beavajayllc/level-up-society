# ---------------------------------------------------------------------------
# WHOP checkout and account linking for Level Up Society
#
# Copy this file to .env.local and fill in the values, then add the same
# variables to Vercel (Project Settings > Environment Variables).
# .env* is gitignored, so these values never reach the repo.
# ---------------------------------------------------------------------------

# WHOP Dashboard > your account > Developers > Apps > OAuth
# Client id starts with app_
WHOP_CLIENT_ID=app_xxxxxxxxxxxxxxxx

# Shown once when the app is created. Regenerate it in the OAuth tab if lost.
WHOP_CLIENT_SECRET=your_client_secret

# WHOP Dashboard > Settings > API Keys. Server side only, never expose it.
WHOP_API_KEY=whop_api_key

# RevenueCat native App Store / Google Play subscription verification.
# Create one `level_up_pro` entitlement and attach both store products to it.
# Keep both values server-side; never expose the Secret API Key to the app.
REVENUECAT_SECRET_API_KEY=your_revenuecat_v1_secret_api_key
REVENUECAT_ENTITLEMENT_ID=level_up_pro
# Set this same secret in the RevenueCat webhook Authorization header as:
# Bearer <secret>
REVENUECAT_WEBHOOK_SECRET=replace_with_a_random_32_plus_character_string

# WHOP Developer > Webhooks > signing secret (starts with ws_). Subscribe to
# membership activated, deactivated, updated, and cancel-at-period-end events.
WHOP_WEBHOOK_SECRET=ws_xxxxxxxxxxxxxxxxxxxx

# Your WHOP account / company id. Starts with biz_
WHOP_ACCOUNT_ID=biz_xxxxxxxxxxxx

# Optional but recommended: the product id that unlocks the members area.
# Starts with prod_. Leave blank to unlock on any active membership.
WHOP_ACCESS_RESOURCE_ID=prod_xxxxxxxxxxxx

# Optional: WHOP checkout link for the $97/mo Level Up Pro membership.
WHOP_CHECKOUT_URL=https://whop.com/your-checkout-link

# The same link, public so the client-side "Join" buttons can use it.
# WHOP is the merchant of record: the buyer checks out on WHOP and the
# membership is created there.
NEXT_PUBLIC_WHOP_CHECKOUT_URL=https://whop.com/your-checkout-link

# true while working in the WHOP sandbox (sandbox.whop.com).
# Remove this line entirely in production.
WHOP_SANDBOX=false

# Encrypts linked WHOP credentials and signs auth state. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=replace_me_with_a_random_32_plus_character_string
# Use the same value in Preview and Production when they share this Supabase project.

# The current deployment's canonical origin. Production stays on www. For the
# stable Vercel Preview alias, set NEXT_PUBLIC_APP_URL in both Preview build
# and runtime to https://level-up-society-auth-preview.vercel.app.
# Add this exact redirect URL in Supabase:
# https://level-up-society-auth-preview.vercel.app/auth/callback
# Add this exact OAuth redirect URI in the Whop app:
# https://level-up-society-auth-preview.vercel.app/api/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Independent Level Up Society website accounts. Create these in the Supabase
# project connected through Vercel Marketplace. The publishable key is safe
# for Supabase Auth; the secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Supabase Auth setup:
# - Keep email confirmation enabled; configure SMTP before inviting real users.
# - Set Site URL to https://www.level-up-society.com.
# - Set production Site URL to https://www.level-up-society.com. In Redirect
#   URLs allow https://www.level-up-society.com/auth/callback, the apex alias
#   callback, localhost:3000/auth/callback, and the Preview callback above.
# - In Whop, register https://www.level-up-society.com/api/auth/callback and
#   the Preview OAuth redirect URI above.
# - Apply supabase/migrations/202610260001_lus_accounts.sql in the SQL editor.

# The WHOP "Livestreaming" experience attached to Level Up Pro. Used for
# titles, schedules, recordings, and chat metadata. Live video is hosted by
# Cloudflare Stream below. Starts with exp_.
WHOP_LIVESTREAM_EXPERIENCE_ID=exp_xxxxxxxxxxxx

# Cloudflare Stream hosts the on-site live video. Create one persistent live
# input with automatic recording, signed playback required, and this site's
# production origin in allowedOrigins. Its RTMPS endpoint/key are used in OBS.
CLOUDFLARE_STREAM_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_STREAM_CUSTOMER_CODE=your_customer_code
CLOUDFLARE_STREAM_LIVE_INPUT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Server-side only. Create a Cloudflare API token with Stream read/write access.
CLOUDFLARE_STREAM_API_TOKEN=your_cloudflare_stream_api_token

# Private custom Telegram gateway deployed as a Cloudflare Worker. The Worker
# uses a D1 database on Cloudflare's free tier and calls this site's internal
# WHOP membership check. Keep the shared secret server-only and match it to
# LUS_GATEWAY_SECRET in the Worker.
TELEGRAM_GATEWAY_URL=https://level-up-society-telegram-gateway.example.workers.dev
TELEGRAM_GATEWAY_SECRET=replace_with_a_random_32_plus_character_string
TELEGRAM_GATEWAY_READY=false
