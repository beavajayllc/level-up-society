# ---------------------------------------------------------------------------
# WHOP auth for the Level Up Society members area
#
# Copy this file to .env.local and fill in the values, then add the same
# variables to Vercel (Project Settings > Environment Variables).
# .env* is gitignored, so these values never reach the repo.
# ---------------------------------------------------------------------------

# WHOP Dashboard > your account > Developers > Apps > OAuth
# Client id starts with app_
WHOP_CLIENT_ID=app_xxxxxxxxxxxxxxxx

# Shown once when the app is created. Regenerate it in the OAuth tab if lost.
WHOP_CLIENT_SECRET=your_client_secret

# WHOP Dashboard > Settings > API Keys. Server side only, never expose it.
WHOP_API_KEY=whop_api_key

# Your WHOP account / company id. Starts with biz_
WHOP_ACCOUNT_ID=biz_xxxxxxxxxxxx

# Optional but recommended: the product id that unlocks the members area.
# Starts with prod_. Leave blank to unlock on any active membership.
WHOP_ACCESS_RESOURCE_ID=prod_xxxxxxxxxxxx

# Optional: WHOP checkout link for the $97/mo Level Up Pro membership.
WHOP_CHECKOUT_URL=https://whop.com/your-checkout-link

# The same link, public so the client-side "Join" buttons can use it.
# WHOP is the merchant of record: the buyer checks out on WHOP and the
# membership is created there.
NEXT_PUBLIC_WHOP_CHECKOUT_URL=https://whop.com/your-checkout-link

# true while working in the WHOP sandbox (sandbox.whop.com).
# Remove this line entirely in production.
WHOP_SANDBOX=false

# Encrypts the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=replace_me_with_a_random_32_plus_character_string

# The site's origin. Must match a registered WHOP redirect URI exactly.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The WHOP "Livestreaming" experience attached to Level Up Pro. Used for
# titles, schedules, recordings, and chat metadata. Live video is hosted by
# Cloudflare Stream below. Starts with exp_.
WHOP_LIVESTREAM_EXPERIENCE_ID=exp_xxxxxxxxxxxx

# Cloudflare Stream hosts the on-site live video. Create one persistent live
# input with automatic recording, signed playback required, and this site's
# production origin in allowedOrigins. Its RTMPS endpoint/key are used in OBS.
CLOUDFLARE_STREAM_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_STREAM_CUSTOMER_CODE=your_customer_code
CLOUDFLARE_STREAM_LIVE_INPUT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Server-side only. Create a Cloudflare API token with Stream read/write access.
CLOUDFLARE_STREAM_API_TOKEN=your_cloudflare_stream_api_token
